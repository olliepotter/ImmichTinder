# Copy to .env and fill in. See docs/DESIGN.md ("Configuration").
# Legacy names (IMMICH_URL, IMMICH_API_KEY / IMMICH_TOKEN, APP_PASSWORD,
# SESSION_SECRET, DATABASE_PATH) are still accepted as fallbacks.

# Immich base URL, no trailing slash (required)
NUXT_IMMICH_URL=http://immich-server:2283

# Immich API key (required). Needs: asset.read, asset.view, asset.update,
# asset.delete, asset.statistics, album.read, user.read
NUXT_IMMICH_API_KEY=replace-with-your-immich-api-key

# Login password (required in production)
NUXT_APP_PASSWORD=replace-with-a-strong-password

# Seals the session cookie, at least 32 characters (required in production)
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters

# SQLite file (optional; default ./data/immich-tinder.db, /data/immich-tinder.db in Docker)
NUXT_DATABASE_PATH=./data/immich-tinder.db

# Public Immich web URL for "Open in Immich" links (optional, not a secret)
NUXT_PUBLIC_IMMICH_WEB_URL=https://photos.example.com

# Secure cookies (optional; default true in production). Set false for plain-HTTP LAN testing.
NUXT_COOKIE_SECURE=true
