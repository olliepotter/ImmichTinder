# Keep the build context to what `npm ci` + `nuxt build` need.

# Dependencies and build output (rebuilt inside the image)
node_modules
.output
.nuxt
.nitro
.cache
.data
dist

# VCS, CI and editor files
.git
.gitignore
.github
.idea
.vscode
.fleet
**/.DS_Store

# Docker / deployment files (not needed inside the image)
Dockerfile*
.dockerignore
docker-compose*.yml
compose*.yml
deploy

# Secrets and local state: never bake these into an image
.env
.env.*
data

# Tests and docs
test
coverage
vitest.config.*
docs
*.md
demo.png

# Logs
logs
*.log
npm-debug.log*
yarn-error.log*
